@page "/"
@using Domain.Entities
@using Pages
@inject Domain.Interface.IFleetApi Api
@inject Domain.Interface.IAnchorageState State


<div class="header-bar">
    <h1 class="app-title">Anchorage</h1>

    <div class="toolbar">
        <button class="btn btn-primary" @onclick="LoadNewFleetAsync">New fleet</button>
        <div class="stats">
            <span>Grid: <strong>@State.Grid.Width × @State.Grid.Height</strong></span>
            <span>•</span>
            <span>Placed: <strong>@State.Placed.Count</strong></span>
        </div>
    </div>
</div>


<div class="layout">
    <div class="left-section">
        <div class="boardHost">
            <AnchorageBoard />
        </div>
     @if(isFleetLoaded){
                 <div class="vessel-status">
            <h4><i class="fas fa-ship"></i> Status (Vessels Remaining)</h4>
            <div class="vessel-list">
                @foreach (var spec in State.Specs)
                {
                    var remaining = spec.Count - State.Placed.Count(p => p.Designation == spec.Designation);
                    <div class="vessel-card @(remaining == 0 ? "empty" : "")">
                        <div class="vessel-info">
                            <div class="vessel-name">@spec.Designation</div>
                            <div class="vessel-size">@($"{spec.Width} × {spec.Height}")</div>
                        </div>
                        <div class="vessel-count">
                            <span>@remaining</span> left
                        </div>
                    </div>
                }
            </div>
        </div>
        }
    </div>

    <div class="right-section">
        <ShipPalette />
        @if (State.Specs.Any() && State.AllVesselsPlaced)
        {
            <div class="congrats-container">
                <div class="congrats-card">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" class="congrats-icon">
                        <path d="M32 4a28 28 0 1 0 28 28A28.031 28.031 0 0 0 32 4zm0 50a22 22 0 1 1 22-22 22.025 22.025 0 0 1-22 22z" />
                        <path d="M27 37.586 20.707 31.3l-2.828 2.828L27 43.243 46.121 24.121l-2.828-2.828z" />
                    </svg>

                    <h3>Congratulations!</h3>
                    <p>All vessels have been successfully anchored.</p>

                    <button class="btn btn-primary" @onclick="LoadNewFleetAsync">Try again</button>
                </div>
            </div>
        }
    </div>
</div>


@code {
    private string? errorMessage;
    private bool isFleetLoaded;

    protected override async Task OnInitializedAsync()
    {
        State.OnChange += StateHasChanged;
        await LoadNewFleetAsync();
    }

    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
    }

    private async Task LoadNewFleetAsync()
    {

        isFleetLoaded = false;
        errorMessage = null;
        StateHasChanged();

        try
        {
            var dto = await Api.GetRandomAsync();

            var grid = new Grid(dto.AnchorageSize.Width, dto.AnchorageSize.Height);

            var specs = dto.Fleets
                .GroupBy(f => f.ShipDesignation)
                .Select(g => new ShipSpecification
                {
                    Designation = g.Key,
                    Width = g.First().SingleShipDimensions.Width,
                    Height = g.First().SingleShipDimensions.Height,
                    Count = g.Sum(x => x.ShipCount)
                });

            State.Reset(grid, specs);
            isFleetLoaded = true;
        }
        catch (HttpRequestException)
        {
            errorMessage = "Failed to reach the fleet API. Please check your connection.";
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = $"API returned invalid data: {ex.Message}";
        }
        catch (Exception ex)
        {
            errorMessage = $"Unexpected error: {ex.Message}";
        }
        finally
        {
            StateHasChanged();
        }
    }

}
