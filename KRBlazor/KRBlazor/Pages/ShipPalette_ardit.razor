@page "/shippalette"
@implements IAsyncDisposable
@implements IDisposable
@inject HttpClient Http
@inject IJSRuntime JS

<h3>Ship Anchorage</h3>

<div id="anchorage-board" style="width:600px;height:400px;border:1px solid #ccc;position:relative;">
    @if (Vessels != null && Vessels.Count > 0)
    {
        @foreach (var vessel in Vessels)
        {
            <div class="vessel"
                 draggable="true"
                 data-vessel="@vessel.Id"
                 style="width:40px;height:40px;background-color:blue;color:white;display:flex;align-items:center;justify-content:center;margin:5px;">
                @vessel.Name
            </div>
        }
    }
    else
    {
        <p>Loading ships...</p>
    }
</div>

@code {
    private IJSObjectReference? dragModule;
    private bool disposed = false;
    private bool shipsLoaded = false;

    public List<Vessel> Vessels { get; set; } = new List<Vessel>();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Fetch ships from your API
            var response = await Http.GetFromJsonAsync<List<Vessel>>("https://esa.instech.no/api/fleets/random");
            if (response != null)
            {
                Vessels = response;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error fetching ships: " + ex.Message);
        }
        shipsLoaded = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && shipsLoaded)
        {
            try
            {
                dragModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/dragModule.js");
                await dragModule.InvokeVoidAsync("init");
                await dragModule.InvokeVoidAsync("enableDrop", DotNetObjectReference.Create(this));
            }
            catch (JSException jsEx)
            {
                Console.WriteLine("JSInterop error: " + jsEx.Message);
            }
        }
    }

    [JSInvokable]
    public void OnDrop(string vesselId, int gx, int gy)
    {
        if (disposed) return;

        var vessel = Vessels.FirstOrDefault(v => v.Id == vesselId);
        if (vessel != null)
        {
            Console.WriteLine($"Dropped {vessel.Name} at {gx},{gy}");
        }

        StateHasChanged();
    }

    public void Dispose() => disposed = true;

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        if (dragModule != null) await dragModule.DisposeAsync();
    }

    public class Vessel
    {
        public string Id { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
    }
}
